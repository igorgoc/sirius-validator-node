# ==============================================================================
# Sirius SuperContract Validator Node — Production Configuration
# ==============================================================================

# Node Identity
NODE_NAME=node1
NODE_PORT=5051
SIRIUS_VM_BIND_HOST=0.0.0.0

# Security: Inter-node Authentication Token (Required when exposed publicly)
# Generate with: openssl rand -hex 32
# If left blank on 0.0.0.0, the node will refuse external connections for security.
SIRIUS_VM_AUTH_TOKEN=

# Sirius Catapult L1 Blockchain Connectivity
SIRIUS_NETWORK=testnet2
SIRIUS_RPC_URL=https://api-2.testnet2.xpxsirius.io

# SuperContract Drive Identifier
DRIVE_KEY_HEX=bd1d100a98c34f62e170a8395b4498dc1e730286f5a12c489b37d01562f0cb23

# Solution 2 (Model A): BFT Validator Co-Signing Keys
# Leave SIRIUS_VALIDATOR_PRIVATE_KEY blank to auto-generate in DATA_DIR/validator_key.json on first boot
SIRIUS_VALIDATOR_PRIVATE_KEY=
SIRIUS_VALIDATOR_CLUSTER_PUBKEY=0B243BA55E8269490A0B8B7BA7D97779E3804A7DBAE1465EB83435B1171F14BE

# Cluster Peer Validators (comma-separated IP/hostname:port of peers)
# e.g. validator1.example.com:5051,validator2.example.com:5051,validator3.example.com:5051
CLUSTER_PEERS=

# Storage & Logging
DATA_DIR=/app/data
CONTRACTS_DIR=/app/contracts
LOG_LEVEL=info
